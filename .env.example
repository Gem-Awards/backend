# Copy this file to .env and fill in real values. Never commit .env to git.

PORT=3000

# Get this from console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-api-key

# WooCommerce REST API (WooCommerce -> Settings -> Advanced -> REST API)
WC_BASE_URL=https://gemawards.com/wp-json/wc/v3
WC_CONSUMER_KEY=your-woocommerce-consumer-key
WC_CONSUMER_SECRET=your-woocommerce-consumer-secret

# CORS: the site(s) allowed to call this backend from the browser widget
ALLOWED_ORIGIN=https://gemawards.com

# Postgres connection string, from Render's database "Connect" button (Internal Database URL)
DATABASE_URL=your-postgres-connection-string

# A random secret string you make up yourself - protects the /api/conversations
# endpoints so only your team (or the future dashboard) can read chat transcripts
ADMIN_API_KEY=make-up-a-long-random-string-here
